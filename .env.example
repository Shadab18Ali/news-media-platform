# ---- Required -------------------------------------------------------------
# Public site URL, no trailing slash. Used for canonical URLs, sitemap, schema.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project settings -> API. Placeholders only; never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used by cron, newsletter and contact form.
SUPABASE_SERVICE_ROLE_KEY=

# Long random string (e.g. `openssl rand -hex 32`). Protects /api/cron/* endpoints.
CRON_SECRET=

# ---- Optional: content-drafting provider (leave empty to disable) -----------
# none | openai-compatible | anthropic
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
# Only for openai-compatible providers, e.g. https://api.openai.com/v1
AI_BASE_URL=

# ---- Optional: connector API for an external writer such as a Custom GPT --------
# 32+ random characters. Leave empty to keep the connector switched off.
CONNECTOR_API_KEY=
